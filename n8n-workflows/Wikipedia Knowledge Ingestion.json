    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// n8n Function node code\nfunction htmlToMarkdown(html) {\n  \n  // Normalize whitespace\n  html = html.replace(/\\r?\\n|\\r/g, \" \");\n\n  // --- BASIC BLOCKS --------------------------------------------\n\n  // Headings\n  html = html.replace(/<h1[^>]*>(.*?)<\\/h1>/gi, \"# $1\\n\\n\");\n  html = html.replace(/<h2[^>]*>(.*?)<\\/h2>/gi, \"## $1\\n\\n\");\n  html = html.replace(/<h3[^>]*>(.*?)<\\/h3>/gi, \"### $1\\n\\n\");\n  html = html.replace(/<h4[^>]*>(.*?)<\\/h4>/gi, \"#### $1\\n\\n\");\n  html = html.replace(/<h5[^>]*>(.*?)<\\/h5>/gi, \"##### $1\\n\\n\");\n  html = html.replace(/<h6[^>]*>(.*?)<\\/h6>/gi, \"###### $1\\n\\n\");\n\n  // Bold / italic\n  html = html.replace(/<(b|strong)[^>]*>(.*?)<\\/\\1>/gi, \"**$2**\");\n  html = html.replace(/<(i|em)[^>]*>(.*?)<\\/\\1>/gi, \"*$2*\");\n\n  // Links: <a href=\"x\">text</a>\n  html = html.replace(/<a[^>]*href=\"([^\"]+)\"[^>]*>(.*?)<\\/a>/gi, \"[$2]($1)\");\n\n  // Images: <img src=\"x\" alt=\"y\" />\n  html = html.replace(/<img[^>]*src=\"([^\"]+)\"[^>]*alt=\"([^\"]*)\"[^>]*>/gi, \"![$2]($1)\");\n\n  // Line breaks\n  html = html.replace(/<br\\s*\\/?>/gi, \"\\n\");\n\n  // Paragraphs\n  html = html.replace(/<p[^>]*>(.*?)<\\/p>/gi, \"$1\\n\\n\");\n\n  // Lists\n  html = html.replace(/<ul[^>]*>/gi, \"\\n\");\n  html = html.replace(/<\\/ul>/gi, \"\\n\");\n  html = html.replace(/<ol[^>]*>/gi, \"\\n\");\n  html = html.replace(/<\\/ol>/gi, \"\\n\");\n\n  html = html.replace(/<li[^>]*>(.*?)<\\/li>/gi, \"- $1\\n\");\n\n  // Code blocks\n  html = html.replace(/<pre[^>]*><code[^>]*>([\\s\\S]*?)<\\/code><\\/pre>/gi, \"```\\n$1\\n```\\n\\n\");\n  html = html.replace(/<code[^>]*>(.*?)<\\/code>/gi, \"`$1`\");\n\n  // Remove all other tags\n  html = html.replace(/<[^>]+>/g, \"\");\n\n  // Clean extra spaces / lines\n  html = html.replace(/\\n{3,}/g, \"\\n\\n\").trim();\n\n  return html;\n}\n\n// ---- USE EXAMPLE ---------------------------------------------------\n\nconst html = $json[\"parse.text['*']\"]; // or wherever you stored it\n\nreturn {\n  json: {\n    markdown: htmlToMarkdown(html)\n  }\n};\n"
      },
