    {
      "parameters": {
        "operation": "extractHtmlContent",
        "extractionValues": {
          "values": [
            {
              "key": "title",
              "cssSelector": "#firstHeading"
            },
            {
              "key": "content",
              "cssSelector": "#mw-content-text",
              "returnValue": "html"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.html",
      "typeVersion": 1.2,
      "position": [
        9552,
        6384
      ],
      "id": "327ad872-c54c-4725-94f5-5f1a0eb86b52",
      "name": "HTML Extractor"
    },
    {
      "parameters": {
        "jsCode": "let content = $input.first().json.content || \"\";\n\ncontent = content.replace(\n  /<span class=\"mw-editsection\">[\\s\\S]*?<span class=\"mw-editsection-bracket\">\\]<\\/span>\\s*<\\/span>/g,\n  ''\n);\n\ncontent = content.replace(\n  /<span class=\"mwe-math-element\">[\\s\\S]*?<img[^>]*alt=\"([^\"]+)\"[^>]*>[\\s\\S]*?<\\/span>/g,\n  (_match, latex) => `\n<ac:structured-macro ac:name=\"math\">\n  <ac:plain-text-body><![CDATA[\n${latex}\n  ]]></ac:plain-text-body>\n</ac:structured-macro>`\n);\n\ncontent = content.replace(\n  /<math[^>]*>([\\s\\S]*?)<\\/math>/g,\n  (_match, latex) => `\n<ac:structured-macro ac:name=\"math\">\n  <ac:plain-text-body><![CDATA[\n${latex}\n  ]]></ac:plain-text-body>\n</ac:structured-macro>`\n);\n\ncontent = content.replace(\n  /<a[^>]*>([\\s\\S]*?)<\\/a>/g,\n  '$1'\n);\n\ncontent = content.replace( /<div class=\"mw-heading mw-heading2\"><h2 id=\"(?:External_links|See_also|Further_Reading)\"[\\s\\S]*?<\\/ul>/g, '' );\n\ncontent = content.replace(\n  /<div class=\"mw-heading mw-heading2\"><h2 id=\"References\"[\\s\\S]*?<\\/div>/g,\n  ''\n);\n\ncontent = content.replace(\n  /<div class=\"mw-heading mw-heading2\"><h2 id=\"Notes\">[\\s\\S]*?<\\/div>/g,\n  ''\n);\n\ncontent = content.replace( /<div class=\"mw-references-wrap\"[\\s\\S]*?<\\/div>/g, '' );\n\ncontent = content.replace(\n  /<div class=\"mw-references-wrap mw-references-columns\"[\\s\\S]*?<\\/div>/g,\n  ''\n);\n\ncontent = content.replace(\n  /<div role=\"navigation\" class=\"navbox\"[\\s\\S]*?<\\/table><\\/div>/g,\n  ''\n);\n\nreturn {\n  json: {\n    title: $input.first().json.title.trim(),\n    content\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        9696,
        6384
      ],
