    {
      "parameters": {
        "jsCode": "let content = $input.first().json.content || \"\";\n\n/**\n * 1. Convert Wikipedia math (span.mwe-math-element)\n *    Uses the LaTeX stored in the `alt` attribute\n */\ncontent = content.replace(\n  /<span class=\"mwe-math-element\">[\\s\\S]*?<img[^>]*alt=\"([^\"]+)\"[^>]*>[\\s\\S]*?<\\/span>/g,\n  (_match, latex) => {\n    return `\n<ac:structured-macro ac:name=\"math\">\n  <ac:plain-text-body><![CDATA[\n${latex}\n  ]]></ac:plain-text-body>\n</ac:structured-macro>`;\n  }\n);\n\n/**\n * 2. Convert inline <math> blocks (fallback)\n */\ncontent = content.replace(\n  /<math[^>]*>([\\s\\S]*?)<\\/math>/g,\n  (_match, latex) => {\n    return `\n<ac:structured-macro ac:name=\"math\">\n  <ac:plain-text-body><![CDATA[\n${latex}\n  ]]></ac:plain-text-body>\n</ac:structured-macro>`;\n  }\n);\n\n/**\n * 3. Fix internal Wikipedia links\n */\ncontent = content.replace(\n  /href=\"\\/wiki\\//g,\n  'href=\"https://en.wikipedia.org/wiki/'\n);\n\nreturn {\n  json: {\n    title: $input.first().json.title,\n    content\n  }\n};\n"
      },
