        "jsonBody": "={\n  \"type\": \"page\",\n  \"title\": \"{{ $('HTML Cleanup').item.json.title }}\",\n  \"space\": { \"key\": \"{{ $('Configuration').item.json.space_key }}\" },\n  \"ancestors\": [\n    {\n      \"id\": \"{{ $('Configuration').item.json.ancestor_id }}\"\n    }\n  ],\n  \"body\": {\n    \"storage\": {\n      \"value\": {{ JSON.stringify( $('HTML Cleanup').item.json.content) }},\n      \"representation\": \"storage\"\n    }\n  }\n}\n",
